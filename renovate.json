{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "schedule": [
    "on monday"
  ],
  "timezone": "UTC",
  "labels": [
    "dependencies",
    "renovate"
  ],
  "commitMessagePrefix": "chore(deps):",
  "prConcurrentLimit": 2,
  "prCreation": "immediate",
  "automerge": false,
  "packageRules": [
    {
      "matchManagers": [
        "maven"
      ],
      "groupName": "ragedunicorn maven plugins",
      "description": "Group all ragedunicorn Maven plugin updates",
      "matchPackageNames": [
        "/^com.ragedunicorn.tools.maven/"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions",
      "description": "Group all GitHub Actions updates"
    },
    {
      "matchDepTypes": [
        "devDependencies"
      ],
      "automerge": true,
      "automergeType": "pr",
      "description": "Automerge dev dependencies"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "ragedunicorn/luacheck"
      ],
      "groupName": "ragedunicorn docker images",
      "description": "Group alpine base bumps for ragedunicorn docker images"
    }
  ],
  "maven": {
    "managerFilePatterns": [
      "/^pom\\.xml$/"
    ]
  },
  "github-actions": {
    "managerFilePatterns": [
      "/^\\.github/workflows/.*\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track alpine base bumps in compound tags for ragedunicorn docker images",
      "managerFilePatterns": [
        "/(^|/)docker-compose[^/]*\\.ya?ml$/"
      ],
      "matchStrings": [
        "image:\\s+(?<depName>ragedunicorn/luacheck):[\\d.]+-alpine(?<currentValue>\\d+\\.\\d+\\.\\d+)-\\d+"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^[\\d.]+-alpine(?<version>\\d+\\.\\d+\\.\\d+)-\\d+$"
    }
  ],
  "prBodyDefinitions": {
    "Package": "{{depName}}",
    "Type": "{{depType}}",
    "Change": "{{updateType}}",
    "Current": "{{currentVersion}}",
    "New": "{{newVersion}}",
    "Age": "{{age}}",
    "Adoption": "{{adoption}}",
    "Passing": "{{passing}}",
    "Confidence": "{{confidence}}"
  },
  "postUpdateOptions": []
}
